<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.dual</groupId>
        <artifactId>hexa-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>hexa-test-support</artifactId>
    <name>hexa-test-support</name>
    <description>Supporto ai test: un PostgreSQL+pgvector vero, un container singleton per suite (PostgresTestContainerInitializer, registrato in META-INF/spring.factories), e le regole di architettura esagonale per un host (HexaArchitectureRules). Da usare con scope test.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
        </dependency>
        <!-- Regole di architettura riusabili dagli host (HexaArchitectureRules). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
        </dependency>
        <!-- Lo richiede Testcontainers (ExceptionUtils); commons-compress di versioni diverse puo' non portarlo piu' con se' (es. con Spring AI/DJL). -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- Qui org.dual.hexa.support E' l'API (regole di architettura, container di test): il parent la esclude dal javadoc aggregato delle librerie. -->
                    <excludePackageNames>org.dual.hexa.app.*</excludePackageNames>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
