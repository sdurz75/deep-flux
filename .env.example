# Copia questo file in .env (mai committato, vedi .gitignore) e valorizzalo
# con il tuo token, generabile su https://replicate.com/account/api-tokens.
#
# Spring Boot legge REPLICATE_API_TOKEN dalle variabili d'ambiente del
# processo (vedi application.yml), non dal file .env direttamente: prima
# di avviare l'app va "sourcizzato" nella shell, es.:
#   set -a; source .env; set +a; mvn spring-boot:run

REPLICATE_API_TOKEN=r8_your_token_here
