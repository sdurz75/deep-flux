# Copia questo file in .env (mai committato, vedi .gitignore) e valorizzalo
# con i tuoi token. Spring Boot lo carica da solo all'avvio (vedi
# spring.config.import in application.yml): non serve "sourcizzarlo"
# nella shell, basta che .env stia nella working directory del processo
# (la root del progetto, es. lanciando `mvn spring-boot:run` da qui).

# Generabile su https://replicate.com/account/api-tokens.
REPLICATE_API_TOKEN=r8_your_token_here

# Generabile su https://openrouter.ai/settings/keys.
OPENROUTER_API_TOKEN=sk-or-your_token_here
