<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>org.dual</groupId>
    <artifactId>hexa-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>hexa-parent</name>
    <description>
        Reactor: hexa-core (libreria riusabile: kernel, UI kit, eventi, push, token, storage, backup, manuale),
        hexa-ai (libreria opzionale sopra hexa-core: chat, ricerca semantica, prompt/visione, crediti OpenRouter),
        hexa-pwa (libreria opzionale sopra hexa-core: manifest, service worker e shell offline per rendere l'app installabile),
        hexa-test-support (container PostgreSQL per i test) e l'app deep-flux (dominio: generazione, training).
    </description>

    <modules>
        <module>hexa-bom</module>
        <module>hexa-test-support</module>
        <module>hexa-core</module>
        <module>hexa-ai</module>
        <module>hexa-pwa</module>
        <module>deep-flux</module>
        <module>hexa-archetype</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- Markdown del manuale (core.manual, adapter markdown). Non e' gestita dalle BOM: versione esplicita. -->
        <commonmark.version>0.24.0</commonmark.version>
        <archunit.version>1.4.2</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>hexa-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>hexa-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>hexa-pwa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>hexa-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Attiva il profilo Spring "test" (src/test/resources/application-test.yml dell'app, override di config del test)
                    per OGNI esecuzione di Surefire, non solo per le classi di test che se lo ricordano con un'annotazione: cosi' una
                    futura classe @SpringBootTest eredita l'isolamento gratis.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <spring.profiles.active>test</spring.profiles.active>
                            <!-- I test non leggono mai lo storage/la migrazione del .env reale (spring.config.import lo
                                 carica anche sotto Surefire): le proprieta' di sistema battono qualunque file di
                                 configurazione. I test che ne hanno bisogno le sovrascrivono con @SpringBootTest(properties). -->
                            <storage.type>local</storage.type>
                            <storage.migration.from-local.enabled>false</storage.migration.from-local.enabled>
                            <!-- Chiave di test (32 byte a zero in base64) per i token API cifrati: senza, userebbe quella del
                                 .env reale (STORAGE_WEBDAV_ENCRYPTION_KEY) e un test potrebbe cifrare con la chiave vera. -->
                            <app.secrets.encryption-key>AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</app.secrets.encryption-key>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <executions>
                        <!-- -sources.jar allegato ai moduli che dichiarano il plugin: mvn deploy lo pubblica. -->
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <executions>
                        <!-- Allegati ai moduli che dichiarano il plugin (hexa-core, hexa-ai, hexa-test-support): mvn deploy pubblica anche -javadoc.jar. -->
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>UTF-8</encoding>
                        <doclint>all,-missing</doclint>
                        <quiet>true</quiet>
                        <additionalOptions>-Xmaxerrs 1000 -Xmaxwarns 1000</additionalOptions>
                        <detectJavaApiLink>true</detectJavaApiLink>
                        <links>
                            <link>https://docs.spring.io/spring-framework/docs/current/javadoc-api/</link>
                        </links>
                        <!-- Solo le librerie: l'app (deep-flux, org.dual.hexa.app) non fa parte dell'API documentata. -->
                        <excludePackageNames>org.dual.hexa.app.*:org.dual.hexa.support.*</excludePackageNames>
                        <overview>${maven.multiModuleProjectDirectory}/src/main/javadoc/overview.html</overview>
                        <windowtitle>hexa ${project.version}</windowtitle>
                        <doctitle>hexa-core e hexa-ai ${project.version}</doctitle>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Documentazione API: mvn -Pjavadoc javadoc:aggregate -> target/reports/apidocs (publicata da .github/workflows/javadoc.yml). Fuori dal build normale. -->
        <profile>
            <id>javadoc</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <inherited>false</inherited>
                        <configuration>
                            <sourcepath>hexa-core/src/main/java:hexa-ai/src/main/java</sourcepath>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
