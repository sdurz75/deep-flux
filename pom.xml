<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>org.dual</groupId>
    <artifactId>dual-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>dual-parent</name>
    <description>
        Reactor: dual-core (libreria riusabile: kernel, UI kit, chat/AI, ricerca, storage, backup, manuale),
        dual-test-support (container PostgreSQL per i test) e l'app spring-htmx-starter (dominio: generazione, training).
    </description>

    <modules>
        <module>dual-test-support</module>
        <module>dual-core</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- Markdown del manuale (core.manual, adapter markdown). Non e' gestita dalle BOM: versione esplicita. -->
        <commonmark.version>0.24.0</commonmark.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>dual-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>dual-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Attiva il profilo Spring "test" (src/test/resources/application-test.yml dell'app, override di config del test)
                    per OGNI esecuzione di Surefire, non solo per le classi di test che se lo ricordano con un'annotazione: cosi' una
                    futura classe @SpringBootTest eredita l'isolamento gratis.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <spring.profiles.active>test</spring.profiles.active>
                            <!-- I test non leggono mai lo storage/la migrazione del .env reale (spring.config.import lo
                                 carica anche sotto Surefire): le proprieta' di sistema battono qualunque file di
                                 configurazione. I test che ne hanno bisogno le sovrascrivono con @SpringBootTest(properties). -->
                            <storage.type>local</storage.type>
                            <storage.migration.from-local.enabled>false</storage.migration.from-local.enabled>
                            <!-- Chiave di test (32 byte a zero in base64) per i token API cifrati: senza, userebbe quella del
                                 .env reale (STORAGE_WEBDAV_ENCRYPTION_KEY) e un test potrebbe cifrare con la chiave vera. -->
                            <app.secrets.encryption-key>AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</app.secrets.encryption-key>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
