<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.dual</groupId>
        <artifactId>hexa-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>hexa-integration-tests</artifactId>
    <packaging>jar</packaging>

    <name>hexa-integration-tests</name>
    <description>
        Test di integrazione e di architettura delle librerie hexa su un host di prova senza dominio (solo sorgenti di test, niente jar pubblicato).
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.dual</groupId>
            <artifactId>hexa-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dual</groupId>
            <artifactId>hexa-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dual</groupId>
            <artifactId>hexa-pwa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dual</groupId>
            <artifactId>hexa-oauth2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dual</groupId>
            <artifactId>hexa-test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.dual</groupId>
            <artifactId>hexa-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.dual</groupId>
            <artifactId>hexa-ai</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Il profilo "test" e le proprieta' di isolamento vengono dalla configurazione di Surefire del parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
