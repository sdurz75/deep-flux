<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- BOM: autonomo di proposito (niente parent), cosi' chi lo importa non eredita le versioni di Spring Boot di hexa-parent. -->
    <groupId>org.dual</groupId>
    <artifactId>hexa-bom</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>hexa-bom</name>
    <description>
        Bill of Materials di hexa: le versioni di hexa-core, hexa-ai, hexa-pwa, hexa-oauth2 e hexa-test-support, allineate. Un host lo importa in dependencyManagement e dichiara
        le dipendenze senza versione. La versione di questo file va tenuta uguale a quella di hexa-parent: se divergono, gli
        archetype IT (che importano il BOM alla versione del parent) falliscono.
    </description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>hexa-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>hexa-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>hexa-pwa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>hexa-oauth2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dual</groupId>
                <artifactId>hexa-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
