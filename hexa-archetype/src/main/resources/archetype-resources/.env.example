# Copia in .env (mai committato). spring.config.import lo legge dalla working directory.

# --- Database: PostgreSQL di sviluppo (`docker compose up -d`, compose.yaml) ---
# HX_DB_NAME e HX_DB_USERNAME sono obbligatori (nessun default nel core); host e porta di default: localhost:5432.
HX_DB_NAME=${dbName}
HX_DB_USERNAME=${dbName}
HX_DB_PASSWORD=changeme
#HX_DB_HOST=localhost
#HX_DB_PORT=5432

# --- Storage dei binari su WebDAV (opzionale, default: filesystem locale in ./data/images) ---
# HX_STORAGE_WEBDAV_ENCRYPTION_KEY=   (base64 di 32 byte: cifra i binari e i token API salvati; se la perdi sono irrecuperabili)
#     openssl rand -base64 32
# Senza chiave /tokens mostra un avviso e non si possono salvare token.
#HX_STORAGE_WEBDAV_ENCRYPTION_KEY=
#if( $useAi == "true" )

# --- AI (hexa-ai) ---
# Token OpenRouter (https://openrouter.ai/settings/keys): chat e visione. Senza, la chat risponde con un errore.
HX_OPENROUTER_API_TOKEN=
#HX_OPENROUTER_CHAT_MODEL=
# Credito residuo nella barra in basso: serve una MANAGEMENT key (https://openrouter.ai/settings/management-keys). Facoltativa.
#HX_OPENROUTER_MANAGEMENT_KEY=
# Ricerca web del bot (SearXNG, formato JSON abilitato): facoltativa.
#SEARXNG_BASE_URL=
#HX_SEARXNG_USERNAME=
#HX_SEARXNG_PASSWORD=
#end
#if( $useOauth2 == "true" )

# --- Accesso con OAuth2/OIDC (hexa-oauth2): l'essenziale, per essere operativi senza altro ---
# Con queste variabili il provider e gli utenti ammessi sono gia' configurati; provider aggiuntivi, ulteriori ammessi e l'interruttore si gestiscono da /oauth2.
# Indirizzo di ritorno da registrare presso il provider: <indirizzo dell'app>/login/oauth2/code/google (o /sso per un OIDC generico). Dietro un reverse proxy
# impostare anche server.forward-headers-strategy=framework (variabile SERVER_FORWARD_HEADERS_STRATEGY=framework).
# Provider: "google" (l'issuer e' implicito) oppure vuoto per un OIDC generico (Keycloak, Authentik, Microsoft con il tenant: serve l'issuer).
#HX_OAUTH2_PROVIDER=google
#HX_OAUTH2_ISSUER_URI=
#HX_OAUTH2_CLIENT_ID=
#HX_OAUTH2_CLIENT_SECRET=
# Chi puo' entrare (elenchi separati da virgole; si SOMMANO a quelli salvati da /oauth2). Un dominio vale solo se UGUALE a quello dell'email.
#HX_OAUTH2_ALLOWED_EMAILS=me@example.com,altro@example.com
#HX_OAUTH2_ALLOWED_DOMAINS=
# Accende il cancello all'avvio. Senza, si accende da /oauth2 dopo un accesso di prova (consigliato la prima volta: fallisce chiuso).
#HX_OAUTH2_ENABLED=true
# Recupero se ci si e' chiusi fuori: spegne il cancello all'avvio (togliere dopo l'uso).
#HX_OAUTH2_RESET=true
#end

# --- Servizio esterno di esempio (opzionale; vedi ExampleRemoteClient) ---
#EXAMPLE_REMOTE_BASE_URL=
