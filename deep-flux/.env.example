# Copia questo file in .env (mai committato, vedi .gitignore) e valorizzalo
# con i tuoi token. Spring Boot lo carica da solo all'avvio (vedi
# spring.config.import in application.yml): non serve "sourcizzarlo"
# nella shell, basta che .env stia nella working directory del processo
# (la root del progetto, es. lanciando `mvn spring-boot:run` da qui).
#
# Tre sezioni: CORE (hexa-core, vedi core.yml), AI (hexa-ai, vedi ai.yml) e APP (specifica di questa applicazione, vedi
# application.yml). Le variabili dei moduli hexa-* hanno il prefisso HX_. Per una nuova webapp si tengono le prime due e
# si sostituisce la terza (docs/TEMPLATE.md).

# =====================================================================================================================
# CORE
# =====================================================================================================================

# --- Database: PostgreSQL con pgvector (dati + ricerca semantica) ---
# `docker compose up -d` avvia quello di sviluppo (compose.yaml) con queste credenziali. HX_DB_NAME e HX_DB_USERNAME sono obbligatori (nessun default); host e porta di default: localhost:5432.
#HX_DB_HOST=localhost
#HX_DB_PORT=5432
HX_DB_NAME=deepflux
HX_DB_USERNAME=deepflux
HX_DB_PASSWORD=changeme

# --- Storage dei binari su WebDAV (opzionale, default: filesystem locale) ---
# Per attivarlo decommenta la riga storage.type (nota: e' il nome della proprieta', non una variabile
# d'ambiente). I contenuti sono cifrati con AES-256-GCM prima di lasciare l'app; il server WebDAV vede solo blob
# illeggibili. Vedi CLAUDE.md, "Convenzione: interfacce e storage dei binari".
#storage.type=webdav

# Collezione WebDAV che conterra' i file (la crea l'app se manca), con slash finale.
# Es. Nextcloud: https://cloud.example.com/remote.php/dav/files/UTENTE/deep-flux/
HX_STORAGE_WEBDAV_URL=https://webdav.example.com/deep-flux/
HX_STORAGE_WEBDAV_USERNAME=your_webdav_username
HX_STORAGE_WEBDAV_PASSWORD=your_webdav_password

# Chiave simmetrica AES-256 in base64: generala con `openssl rand -base64 32`. Conservane una COPIA (es. password
# manager): se la perdi i binari su WebDAV non sono piu' recuperabili; se la cambi quelli gia' caricati non si aprono.
# Cifra ANCHE i token API salvati nel DB (/tokens, app.secrets.encryption-key la riusa): con storage.type=local resta
# facoltativa, ma senza di essa /tokens non permette di salvare token.
HX_STORAGE_WEBDAV_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# Backup/ripristino del jar (`java -jar app.jar export|import <file>`, vedi README): l'archivio e' cifrato con questa chiave, che se
# manca vale HX_STORAGE_WEBDAV_ENCRYPTION_KEY (nessun segreto in piu' da conservare). Per ripristinare serve la stessa chiave dell'export.
# Impostala solo per separare la chiave dei backup da quella dello storage. Il backup non contiene mai il .env ne' queste credenziali.
#HX_BACKUP_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# Migrazione una tantum dei file esistenti in ./data/images verso WebDAV: decommenta per UN avvio (con
# storage.type=webdav), poi ricommenta. delete-local elimina gli originali solo dopo verifica sul server.
#storage.migration.from-local.enabled=true
#storage.migration.from-local.delete-local=false

# =====================================================================================================================
# AI (hexa-ai)
# =====================================================================================================================

# Generabile su https://openrouter.ai/settings/keys.
HX_OPENROUTER_API_TOKEN=sk-or-your_token_here

# Management key OpenRouter (opzionale): serve SOLO a leggere il credito residuo mostrato nella barra in basso (GET /api/v1/credits non
# accetta il token della chat). Generabile su https://openrouter.ai/settings/management-keys; senza, il credito OpenRouter non compare.
#HX_OPENROUTER_MANAGEMENT_KEY=sk-or-your_management_key_here

# Modelli OpenRouter (opzionali: i default stanno in ai.yml). Chat di /deep-chat, e visione dell'"AI enhance" di
# video/modifica immagine (con un secondo modello usato UNA volta se il primo rifiuta).
#HX_OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4.1-flash
#HX_OPENROUTER_VISION_MODEL=qwen/qwen3-vl-32b-instruct
#HX_OPENROUTER_VISION_FALLBACK_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Credenziali Basic Auth della tua istanza SearXNG, usata dal tool di web search del modello su /deep-chat
# (vedi WebSearchTool/SearxngClient). L'URL dell'istanza e' dell'app (sezione APP).
HX_SEARXNG_USERNAME=your_searxng_username
HX_SEARXNG_PASSWORD=your_searxng_password

# =====================================================================================================================
# APP (generazione immagini, chat, ricerca)
# =====================================================================================================================

# Generabile su https://replicate.com/account/api-tokens.
REPLICATE_API_TOKEN=r8_your_token_here

# URL della tua istanza SearXNG (la ricerca web del bot).
#SEARXNG_BASE_URL=https://searxng.example.com/xng/

# =====================================================================================================================
# ACCESSO CON OAUTH2 (hexa-oauth2, opzionale)
# =====================================================================================================================
# Spento di default: l'app e' aperta come prima. Queste variabili bastano per essere operativi; provider aggiuntivi, ulteriori ammessi e
# l'interruttore si gestiscono da /oauth2 (menu Gestione). Indirizzo di ritorno da registrare presso il provider:
#   <indirizzo dell'app>/login/oauth2/code/google   (o /sso per un OIDC generico)
# Dietro un reverse proxy: SERVER_FORWARD_HEADERS_STRATEGY=framework (e X-Forwarded-Prefix per un sottopercorso).
# Provider: "google" (issuer implicito) oppure vuoto per un OIDC generico (Keycloak, Authentik, Microsoft con il tenant: serve l'issuer).
#HX_OAUTH2_PROVIDER=google
#HX_OAUTH2_ISSUER_URI=
#HX_OAUTH2_CLIENT_ID=
#HX_OAUTH2_CLIENT_SECRET=
# Chi puo' entrare (elenchi separati da virgole, SOMMATI a quelli salvati da /oauth2). Un dominio vale solo se UGUALE a quello dell'email.
#HX_OAUTH2_ALLOWED_EMAILS=me@example.com
#HX_OAUTH2_ALLOWED_DOMAINS=
# Accende il cancello all'avvio (la prima volta meglio da /oauth2, dopo un accesso di prova: fallisce chiuso).
#HX_OAUTH2_ENABLED=true
# Recupero se ci si e' chiusi fuori: spegne il cancello all'avvio (da togliere dopo l'uso).
#HX_OAUTH2_RESET=true
